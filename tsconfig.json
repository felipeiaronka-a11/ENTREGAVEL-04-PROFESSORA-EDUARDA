{
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "lib": [
            "dom",
            "es2015",
            "es2017"
        ],
        "jsx": "react-jsx"
    }
}